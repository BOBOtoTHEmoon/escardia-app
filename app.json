{
  "expo": {
    "name": "Escardia",
    "slug": "escardia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.escardia",
      "supportsTablet": false,
      "userInterfaceStyle": "automatic",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby cars and set pickup points."
      }
    },
    "android": {
      "package": "app.escardia",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1530"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0D1A3F"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F5FED"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We need your location to show nearby cars and set pickup points."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escardia uses your photos so you can add a profile picture and car photos.",
          "cameraPermission": "Escardia uses your camera so you can take a profile picture and car photos.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBVsDFJQlUTcFZmV__w-UtX0a9tlKe4FFc"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "778aa0c7-92ea-41d1-a06f-60f0b2fb15eb"
      }
    },
    "scheme": "escardia"
  }
}
