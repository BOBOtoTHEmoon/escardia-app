{
  "expo": {
    "name": "Escardia",
    "slug": "Escardiaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1A3F"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show nearby cars and set pickup points."
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1530"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F5FED"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We need your location to show nearby cars and set pickup points."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escardia uses your photos so you can add a profile picture and car photos.",
          "cameraPermission": "Escardia uses your camera so you can take a profile picture and car photos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "778aa0c7-92ea-41d1-a06f-60f0b2fb15eb"
      }
    }
  }
}
